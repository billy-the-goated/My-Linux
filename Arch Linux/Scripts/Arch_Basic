#!/usr/bin/env bash
# Arch Linux setup: yay -> KDE Plasma -> ly -> apps
# Run as a normal user with sudo rights (NOT as root):  bash arch-setup.sh

set -euo pipefail

# ---------- helpers ----------
info() { printf '\n\033[1;34m==>\033[0m \033[1m%s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*"; }

if [[ $EUID -eq 0 ]]; then
    echo "Don't run this as root. makepkg/yay refuse to run as root."
    echo "Run it as your normal user; it will call sudo when needed."
    exit 1
fi

command -v sudo >/dev/null || { echo "sudo is required. Install and configure it first."; exit 1; }

# ---------- package lists ----------
# Official repos (pacman)
KDE_PKGS=(
    plasma-meta          # Plasma desktop + integration pieces
    dolphin              # file manager
    ark                  # archive manager
    pipewire pipewire-pulse pipewire-alsa wireplumber   # audio
    networkmanager       # needed by plasma-nm
    xdg-desktop-portal-kde
)

PACMAN_APPS=(
    discord
    obs-studio
    kitty
    shotcut
    okular
    qbittorrent
    vlc
    mpv
    spotify-launcher
    ruby
    # optional helpers for yazi previews/features
    ffmpeg 7zip jq poppler fd ripgrep fzf zoxide imagemagick
)

# AUR (yay)
AUR_APPS=(
    waterfox-bin
    visual-studio-code
)

# ---------- 1. system update + build tools ----------
info "Updating system and installing build tools"
sudo pacman -Syu --noconfirm
sudo pacman -S --needed --noconfirm base-devel git

# ---------- 2. yay ----------
if command -v yay >/dev/null; then
    info "yay already installed, skipping"
else
    info "Installing yay (yay-bin from the AUR)"
    tmpdir=$(mktemp -d)
    trap 'rm -rf "$tmpdir"' EXIT
    git clone https://aur.archlinux.org/yay-bin.git "$tmpdir/yay-bin"
    (cd "$tmpdir/yay-bin" && makepkg -si --noconfirm)
fi

# ---------- 3. KDE Plasma ----------
info "Installing KDE Plasma"
sudo pacman -S --needed --noconfirm "${KDE_PKGS[@]}"
sudo systemctl enable NetworkManager.service

# ---------- 4. ly display manager ----------
info "Installing and enabling ly"
sudo pacman -S --needed --noconfirm ly

# Make sure no other display manager is enabled
for dm in sddm gdm lightdm lxdm greetd; do
    if systemctl is-enabled "$dm.service" &>/dev/null; then
        warn "Disabling $dm.service so ly can take over"
        sudo systemctl disable "$dm.service"
    fi
done

# Newer ly versions use a templated unit (ly@tty2), older ones use ly.service
if systemctl list-unit-files 'ly@.service' --no-legend 2>/dev/null | grep -q 'ly@'; then
    sudo systemctl disable getty@tty2.service 2>/dev/null || true
    sudo systemctl enable ly@tty2.service
else
    sudo systemctl disable getty@tty2.service 2>/dev/null || true
    sudo systemctl enable ly.service
fi

# ---------- 5. applications ----------
info "Installing applications from the official repos"
sudo pacman -S --needed --noconfirm "${PACMAN_APPS[@]}"

info "Installing applications from the AUR"
yay -S --needed --noconfirm "${AUR_APPS[@]}"

# ---------- done ----------
info "All done!"
echo "Reboot to land on the ly greeter, then pick 'Plasma (Wayland)' or 'Plasma (X11)' with the arrow keys."
read -rp "Reboot now? [y/N] " answer
if [[ "${answer,,}" == "y" ]]; then
    sudo reboot
fi
